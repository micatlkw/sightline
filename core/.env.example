# ── Process Privileges (Non-Root User/Group ID) ───────────────────────────
# Run container processes as unprivileged host user (e.g. id -u / id -g is 1000:1000, or 1026:100 on Synology)
PUID=1026
PGID=100

# ── Paths ──────────────────────────────────────────────────────────────────────
INCOMING_DIR=/data/incoming
PROCESSED_DIR=/data/processed
DB_PATH=/data/sightline.db
MODELS_DIR=/models
THUMBNAILS_DIR=/data/thumbnails

# ── Detection ──────────────────────────────────────────────────────────────────
YOLO_MODEL=yolo11n.pt
# COCO class IDs: person(0), car(2), motorcycle(3), truck(7), cat(15), dog(16), bear(21)
TARGET_CLASSES=[0,2,3,7,15,16,21]
CONFIDENCE_THRESHOLD=0.45
# Keyframe interval: 30 = 1 frame/sec at 30fps
VID_STRIDE=30

# ── File Watcher ───────────────────────────────────────────────────────────────
# false = inotify (recommended when running on the NAS itself via DSM Container Manager)
# true  = polling fallback (use if watch dir is an NFS/SMB network mount)
WATCH_USE_POLLING=false
# Seconds of stable file size before a new clip is considered fully written
CLIP_STABLE_SECONDS=2.0

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Authentication (Google SSO) ────────────────────────────────────────────
# JSON list of allowed Google account emails.
# If empty, authentication is bypassed (for local development/testing).
ALLOWED_GOOGLE_EMAILS=[]
# Optional Google OAuth client ID:
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Notifications (Firebase Cloud Messaging & Apprise) ─────────────────────────
# Path to Firebase serviceAccountKey.json (placed in persistent ./sightline-models)
FIREBASE_CREDENTIALS_PATH=/models/firebase_credentials.json

# JSON list of Apprise notification URLs (optional fallback). Leave empty to disable.
# Examples:
#   ntfy (free, self-hosted):  ntfys://ntfy.sh/my-secret-topic
#   Pushover (Android/iOS):    pover://AppToken/UserKey
#   Gotify (self-hosted):      gotifys://mynas.local/AppToken
#   Slack:                     slack://TokenA/TokenB/TokenC/Channel
APPRISE_URLS=[]

# Minimum seconds between alerts per camera (prevents alert storms)
ALERT_COOLDOWN_SECONDS=60
